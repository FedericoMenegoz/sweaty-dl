{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SweatyDL Next",
  "version": "0.1.1",
  "identifier": "com.sweatydl.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SweatyDL",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost; media-src https://*.bcbits.com/stream/"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5MDhDM0Q4OTlBMUFDRkQKUldUOXJLR1oyTU1JQ2FQdnJ4NGY0dlBVVmd2L3dqV2JEdUQ4M3E1NEdLQzFyOE43cE5QNmwybEcK",
      "endpoints": [
        "https://github.com/FedericoMenegoz/sweaty-dl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
